'use client';
import { useState, useEffect } from 'react';
import { SidebarV2 } from '../components/SidebarV2';
import { UDNBar } from '../components/UDNBar';
import { GraficaCruceSenales } from '../components/GraficaCruceSenales';
import { ScoreCardsConvergencia } from '../components/ScoreCardsConvergencia';
import { UDNS } from '../lib/data';
import { useAuth } from '../hooks/useAuth';
import type { UDN } from '../lib/types';

export default function PreviewPage() {
  const { perfil, loading } = useAuth();
  const [udnActiva, setUdnActiva] = useState<UDN>(UDNS[0]);
  const [moduloActivo, setModuloActivo] = useState<'comercial' | 'demanda'>('comercial');

  useEffect(() => {
    document.documentElement.setAttribute('data-theme', 'light');
  }, []);

  if (process.env.NEXT_PUBLIC_PREVIEW_MODE !== 'true') {
    return <div style={{ padding: 40, textAlign: 'center', color: 'var(--txt-4)' }}>Vista en construcción.</div>;
  }
  if (loading) return null;

  return (
    <div style={{ display: 'flex', flexDirection: 'row', height: '100vh', overflow: 'hidden', backgroundColor: 'var(--bg)' }}>
      <SidebarV2 acento={udnActiva.color} moduloActivo={moduloActivo} onModuloChange={setModuloActivo} />
      <div style={{ display: 'flex', flexDirection: 'column', flex: 1, overflow: 'auto', minWidth: 0 }}>
        <div style={{ padding: '16px 20px', borderBottom: '1px solid var(--border)' }}>
          <h1 style={{ fontSize: 18, fontWeight: 600, margin: 0, color: 'var(--txt-1)' }}>Brújula Comercial</h1>
          <p style={{ fontSize: 12, color: 'var(--txt-5)', margin: '4px 0 0' }}>
            {moduloActivo === 'comercial' ? 'Inteligencia Comercial' : 'Inteligencia de Demanda'}
          </p>
        </div>
        <UDNBar
          udns={perfil?.rol === 'admin' ? UDNS : UDNS.filter(u => (perfil?.udn || '').split(',').map((s: string) => s.trim()).includes(u.id))}
          udnActiva={udnActiva}
          onSelect={setUdnActiva}
          isDark={false}
        />
        {moduloActivo === 'comercial' ? (
          <div style={{ padding: 20, display: 'flex', flexDirection: 'column', gap: 20 }}>
            <div>
              <p style={{ fontSize: 13, fontWeight: 500, margin: '0 0 8px', color: 'var(--txt-1)' }}>
                Cruce de señales · {udnActiva.nombre}
              </p>
              <GraficaCruceSenales brandColor={udnActiva.color} isDark={false} />
            </div>
            <div>
              <p style={{ fontSize: 13, fontWeight: 500, margin: '0 0 8px', color: 'var(--txt-1)' }}>
                Empresas en convergencia
              </p>
              <ScoreCardsConvergencia />
            </div>
          </div>
        ) : (
          <div style={{ padding: 20, color: 'var(--txt-3)' }}>Inteligencia de Demanda — próximo paso.</div>
        )}
      </div>
    </div>
  );
}
